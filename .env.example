# GCP project settings
GCP_PROJECT_ID=neo-group-499309
GCP_LOCATION=asia-southeast1

# GCS bucket where uploaded images are stored (bucket NAME only, no gs:// prefix)
GCS_BUCKET=neogroup_bucket

# LEGACY / not used by the current app — kept only because app/vector_search.py,
# app/scheduler.py, and app/usage_meter.py (retired but not deleted, see
# CHANGELOG.md) still reference these settings if you ever import them
# directly. Text search now runs on an in-process FAISS index instead
# (see app/faiss_index.py) — nothing in the normal running app reads these.
VERTEX_INDEX_ID=938459562585882624
VERTEX_INDEX_ENDPOINT_ID=6429653728164315136
VERTEX_DEPLOYED_INDEX_ID=deployed_ocr_index

# Text embedding model — used for OCR-text search (see /search, now FAISS-backed)
VERTEX_TEXT_EMBEDDING_MODEL=text-embedding-004
VERTEX_EMBEDDING_DIM=768

# Multimodal embedding model — used for image similarity search (see /search/image).
# Different vector space than the text model above (1408-dim by default). Image
# search uses a brute-force scan over Firestore (app/similarity.py), not FAISS —
# see README's "Image similarity search" section for why.
VERTEX_MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
VERTEX_IMAGE_EMBEDDING_DIM=1408

# Airtable source connector — pulls images + record metadata directly from
# a base via POST /ingest/airtable, instead of manual upload. Optional —
# only needed if you use that endpoint. Get a Personal Access Token at
# https://airtable.com/create/tokens with data.records:read scope on the
# base below. Base ID is in the base's API docs (starts with "app...").
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# Fields to write ingest results back onto the source Airtable record —
# must already exist in your base (OCR Text: long text, Indexed: checkbox,
# Doc ID: single line text). Write-back is best-effort; a missing field
# won't fail the ingest itself, just that one write-back.
AIRTABLE_WRITE_OCR_TEXT_FIELD=OCR Text
AIRTABLE_WRITE_INDEXED_FIELD=Indexed
AIRTABLE_WRITE_DOC_ID_FIELD=Doc ID

# Shared secret for POST /webhooks/airtable (the Airtable Automation
# "Send webhook" endpoint) — required as ?secret=... or an
# X-Webhook-Secret header once set. Blank = no check. See README for the
# Automation setup that calls this endpoint.
AIRTABLE_WEBHOOK_SECRET=

# LEGACY / not used by the current app — app/scheduler.py and
# app/usage_meter.py are retired (no longer wired into main.py, see
# CHANGELOG.md) since there's no deployed endpoint left to schedule or
# meter. Kept only so those files still import cleanly if you look back
# at them; safe to delete this whole block.
VECTOR_SEARCH_SCHEDULE_ENABLED=false
VECTOR_SEARCH_DEPLOY_CRON=0 9 * * 1-5
VECTOR_SEARCH_UNDEPLOY_CRON=0 18 * * 1-5
VECTOR_SEARCH_SCHEDULE_TIMEZONE=Asia/Singapore
VECTOR_SEARCH_HOURLY_RATE_ESTIMATE_USD=0.87

# Auth: point this at a service account key with Vision API + Vertex AI + Storage roles
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Single-user login gate for the web app itself (see app/auth.py) — not a
# GCP credential, just the one account allowed to sign in at /login.
# Placeholders here on purpose — put your real values only in .env, never here.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
